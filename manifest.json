{
  "manifest_version": 3,
  "name": "Google Hacking 助手",
  "version": "1.3",
  "description": "一键触发Google和百度Hacking搜索语法，简化安全研究和渗透测试流程",
  "homepage_url": "https://github.com/Pa55w0rd/google-hacking-assistant",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
