{
  "manifest_version": 3,
  "name": "Search Hacking 助手",
  "version": "2.0.0",
  "description": "在Google和百度搜索结果页面显示Hacking语法侧边栏，帮助用户进行高级搜索操作",
  "homepage_url": "https://github.com/Pa55w0rd/google-hacking-assistant",
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "js/background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.google.com/*",
    "*://*.google.co.jp/*",
    "*://*.google.co.uk/*",
    "*://*.google.com.hk/*",
    "*://*.google.co.in/*",
    "*://*.google.fr/*",
    "*://*.google.de/*",
    "*://*.google.it/*",
    "*://*.google.es/*",
    "*://*.google.ca/*",
    "*://*.google.com.br/*",
    "*://*.google.com.au/*",
    "*://*.google.ru/*",
    "*://*.google.nl/*",
    "*://*.baidu.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/*"],
      "matches": ["<all_urls>"]
    }
  ]
} 